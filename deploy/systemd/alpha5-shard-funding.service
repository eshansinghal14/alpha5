[Unit]
Description=alpha5: top up any trading shard below its cash floor (infra/runtime/shard_funding.py)

[Service]
Type=oneshot
# ubuntu holds the Kalshi key.
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONPATH=/opt/alpha5
ExecStart=/opt/alpha5/.venv/bin/python -W ignore -m infra.runtime.shard_funding
TimeoutStartSec=2min
Nice=10
MemoryMax=300M
