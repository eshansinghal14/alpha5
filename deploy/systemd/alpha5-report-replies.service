[Unit]
Description=alpha5: apply the owner's email replies to the daily review (infra.runtime.report_replies)
After=network-online.target
ConditionPathExists=/etc/alpha5/gmail-app-password

[Service]
Type=oneshot
# ubuntu owns the strategies' config.json, which an approved proposal edits.
User=ubuntu
WorkingDirectory=/opt/alpha5
ExecStart=/opt/alpha5/.venv/bin/python -W ignore -m infra.runtime.report_replies poll
TimeoutStartSec=4min
# Claude Code (deploy/claude_reply.sh) runs in this unit's memory when there's a reply.
Nice=19
OOMScoreAdjust=1000
MemoryMax=900M
