[Unit]
Description=alpha5 KXSOL15M (single-coin 15M), shadow unless armed
After=network-online.target chrony.service alpha5-crypto.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Own process, normal priority. Inside the below_normal five-coin shadow
# process SOL's loop lag hit p95 1.1s and 30% of its quotes were blocked
# stale_signal while armed (2026-10-19 16:00 UTC).
Environment=CRYPTO15M_GROUP=crypto15m-sol
Environment=ALPHA5_PRIORITY=normal
Nice=0
# alpha5-crypto writes the shared spot files (composite bars, CF index, prints); read them only.
Environment=CRYPTO15M_PERSIST=0
# Same shard (2) as alpha5-crypto, which has no way to see this process's
# writes: capped at 20% of the 300/s budget (60/s). ETH used ~10/s live.
Environment=KALSHI_WRITE_SHARE=0.2
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --only KXSOL15M --resume-arm
KillSignal=SIGINT
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/crypto15m-sol.out.log
StandardError=append:/opt/alpha5/data/live/crypto15m-sol.err.log

[Install]
WantedBy=multi-user.target
