[Unit]
Description=alpha5 single-coin 15M crypto in shadow: KXBTC15M, KXSOL15M, KXXRP15M, KXHYPE15M (never resumes armed)
After=network-online.target chrony.service alpha5-crypto.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# One process and one SpotFeed for all four (CRYPTO15M/__init__.py); separate
# from alpha5-crypto so the race's trading loop doesn't carry them.
Environment=CRYPTO15M_GROUP=crypto15m-shadow
# alpha5-crypto writes the shared spot files (composite bars, CF index, prints); read them only.
Environment=CRYPTO15M_PERSIST=0
# Yields to every trading process on the box.
Environment=ALPHA5_PRIORITY=below_normal
Nice=10
# No --resume-arm-h: a restart always comes back in shadow.
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --only KXBTC15M KXSOL15M KXXRP15M KXHYPE15M
KillSignal=SIGINT
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/crypto15m-shadow.out.log
StandardError=append:/opt/alpha5/data/live/crypto15m-shadow.err.log

[Install]
WantedBy=multi-user.target
