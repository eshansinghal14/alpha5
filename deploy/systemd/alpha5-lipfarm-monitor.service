[Unit]
Description=alpha5 LIPFARM watchdog: log changes, disarm the farm on a loss/exposure/ARBS rule (kalshi_strategies/LIPFARM/monitor.py)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/alpha5/.venv/bin/python -W ignore -m kalshi_strategies.LIPFARM.monitor
StandardOutput=append:/opt/alpha5/data/live/lipfarm_monitor.log
StandardError=append:/opt/alpha5/data/live/lipfarm_monitor.log
TimeoutStartSec=120
Nice=10
