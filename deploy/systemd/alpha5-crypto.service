[Unit]
Description=alpha5 KXCRYPTOLEAD15M live trading (shadow unless armed)
After=network-online.target chrony.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --series KXCRYPTOLEAD15M
# Trading outranks everything on the box (kalshi_infra/runtime/priority.py).
# Nice=-5 needs root to grant, which systemd does before dropping to User.
# The writer child lowers itself to 19; the venue child sets 0.
Nice=-5
# Ctrl-C equivalent: the process pulls every quote on SIGINT before exiting.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/run.out.log
StandardError=append:/opt/alpha5/data/live/run.err.log

[Install]
WantedBy=multi-user.target
