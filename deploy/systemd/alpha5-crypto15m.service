[Unit]
Description=alpha5 single-coin 15M (KXETH15M, KXSOL15M, KXXRP15M, KXHYPE15M), shadow unless armed
After=network-online.target chrony.service alpha5-crypto.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Four coins in one process: one SpotFeed, one venue child, one write bucket.
# KXBTC15M has its own (alpha5-crypto15m-btc): its Kalshi book alone changes
# touch ~300/s vs ~20-77/s for each of these, and all five in one process ran
# at 71% CPU with loop lag p95 75ms in shadow (10-20 16:45 UTC).
Environment=CRYPTO15M_GROUP=crypto15m
Environment=ALPHA5_PRIORITY=normal
Nice=0
# alpha5-crypto writes the shared spot files and records books/prints; this
# process and its venue child only read them.
Environment=CRYPTO15M_PERSIST=0
# Write budget: shard 2's whole bucket, shared with alpha5-crypto and
# alpha5-crypto15m-btc (orders.shard_budget); per-series cap
# quoting.max_write_tokens_per_s.
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --only KXETH15M KXSOL15M KXXRP15M KXHYPE15M --resume-arm
KillSignal=SIGINT
TimeoutStopSec=90
# Last for the OOM killer; non-trading units run at +1000 and go first. The
# writer and feed children inherit it. No MemoryMax: a cap would kill trading.
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/crypto15m.out.log
StandardError=append:/opt/alpha5/data/live/crypto15m.err.log

[Install]
WantedBy=multi-user.target
