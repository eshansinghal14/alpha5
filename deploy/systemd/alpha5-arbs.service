[Unit]
Description=alpha5 ARBS cross-market basket arbitrage, shadow unless armed
After=network-online.target chrony.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --series ARBS --resume-arm
# Below crypto (nice -5) and S&P: these books move on news, not milliseconds.
Environment=ALPHA5_PRIORITY=normal
Nice=5
KillSignal=SIGINT
TimeoutStopSec=90
# Last for the OOM killer; non-trading units run at +1000 and go first. The
# writer and feed children inherit it. No MemoryMax: a cap would kill trading.
OOMScoreAdjust=-900
# The scan child raises itself to +1000 and is often the one killed; the
# default (stop) then took the whole unit down with it (3 restarts, 11-02 21:00).
# A killed scan is just a failed scan, retried next interval.
OOMPolicy=continue
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/arbs.out.log
StandardError=append:/opt/alpha5/data/live/arbs.err.log

[Install]
WantedBy=multi-user.target
