[Unit]
Description=alpha5 Polymarket US recorder: every open market's book changes, trades and metadata (infra/polymarket/recorder.py)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/alpha5/.venv/bin/python -u -W ignore -m infra.polymarket.recorder
# Research only: below trading for CPU and first for the OOM killer.
Nice=10
OOMScoreAdjust=1000
MemoryMax=800M
Restart=always
RestartSec=30
StandardOutput=append:/opt/alpha5/data/live/pm_rec.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
