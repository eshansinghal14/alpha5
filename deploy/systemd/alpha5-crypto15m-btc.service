[Unit]
Description=alpha5 KXBTC15M (single-coin 15M), shadow unless armed
After=network-online.target chrony.service alpha5-crypto.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/alpha5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Own process: its Kalshi book changes touch ~300/s (10-20), as much as the
# other four coins together, and runs the full dispatch on each.
Environment=CRYPTO15M_GROUP=crypto15m-btc
Environment=ALPHA5_PRIORITY=normal
Nice=0
Environment=CRYPTO15M_PERSIST=0
# Write budget: shard 2's whole bucket, shared with alpha5-crypto and
# alpha5-crypto15m (orders.shard_budget).
ExecStart=/opt/alpha5/.venv/bin/python -u -m kalshi_strategies.run --only KXBTC15M --resume-arm
KillSignal=SIGINT
TimeoutStopSec=90
# Last for the OOM killer; non-trading units run at +1000 and go first. The
# writer and feed children inherit it. No MemoryMax: a cap would kill trading.
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/alpha5/data/live/crypto15m-btc.out.log
StandardError=append:/opt/alpha5/data/live/crypto15m-btc.err.log

[Install]
WantedBy=multi-user.target
