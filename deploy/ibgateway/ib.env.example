# Copy to deploy/ibgateway/ib.env (gitignored) and fill in; push_secrets.ps1
# copies it to the server. The IBKR login whose account has the OPRA
# subscription (the main login is fine: logging in elsewhere just takes the
# session until the gateway takes it back).
TWS_USERID=
TWS_PASSWORD=
# Password for the VNC screen (only reachable through the SSH tunnel).
VNC_SERVER_PASSWORD=
